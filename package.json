{
  "name": "zen-browser-bridge",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "lint": "web-ext lint --source-dir addon --warnings-as-errors",
    "build": "web-ext build --source-dir addon --overwrite-dest",
    "host:install": "node install.cjs",
    "publish:amo": "web-ext sign --source-dir addon --channel listed --amo-metadata amo-metadata.json"
  },
  "devDependencies": {
    "web-ext": "10.6.0"
  }
}
