{
  "manifest_version": 2,
  "name": "Zen Browser Bridge",
  "version": "0.2.0",
  "description": "Expose browser tabs to local applications through Native Messaging.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zen-browser-bridge@sandzhaj",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "sessions"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  }
}
